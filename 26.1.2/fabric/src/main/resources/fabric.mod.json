  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "icon": "assets/pointblank_recipe/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "xyz.samiker.pointblank_recipe.client.Pointblank_recipeClient"
    ],
